{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shared-memory-registration-local-only",
  "main": "scripts/registration-worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "registration-local-only" }],
  "observability": { "enabled": false },
}
