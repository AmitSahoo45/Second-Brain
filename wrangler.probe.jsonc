{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shared-memory-probe-local",
  "main": "src/probe.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "local",
    "MCP_RESOURCE_URL": "http://127.0.0.1:8787/mcp",
    "HMAC_SECRET": "local-only-hmac-secret-do-not-use-elsewhere",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "probe-local-only",
      "database_id": "local-only",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-only" }],
  "observability": { "enabled": false },
}
