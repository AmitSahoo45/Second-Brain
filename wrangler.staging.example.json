{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shared-memory-probe-staging",
  "account_id": "<SELECTED_CLOUDFLARE_ACCOUNT_ID>",
  "main": "src/probe.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "staging",
    "STAGING_WORKERS_SUBDOMAIN": "<SELECTED_ACCOUNT_WORKERS_SUBDOMAIN>",
    "MCP_RESOURCE_URL": "https://shared-memory-probe-staging.REPLACE_WITH_ACCOUNT_SUBDOMAIN.workers.dev/mcp",
    "GITHUB_OWNER_ID": "<VERIFIED_IMMUTABLE_NUMERIC_SUBJECT>",
    "GITHUB_CLIENT_ID": "<REGISTERED_GITHUB_OAUTH_APP_ID>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<STAGING_DATABASE_NAME>",
      "database_id": "<STAGING_D1_UUID>",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<STAGING_KV_ID>" }],
  "observability": { "enabled": false }
}
