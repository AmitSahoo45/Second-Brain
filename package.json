{
  "name": "shared-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "test": "vitest run",
    "test:tooling": "node --experimental-strip-types --test tests/tooling/*.test.mts",
    "test:browser:consent": "wrangler deploy --dry-run --config wrangler.browser-test.jsonc --outdir dist/browser && node --experimental-strip-types scripts/test-consent-browser.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check src tests scripts web *.json *.jsonc *.mts .github/workflows/*.yml",
    "format": "prettier --write src tests scripts web *.json *.jsonc *.mts .github/workflows/*.yml",
    "build": "wrangler deploy --dry-run --outdir dist/production",
    "build:probe": "wrangler deploy --config wrangler.probe.jsonc --dry-run --outdir dist/probe",
    "dev": "wrangler dev --config wrangler.probe.jsonc --local",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:tooling && npm run check:dependencies && npm run build && npm run build:probe",
    "check:dependencies": "node scripts/check-dependencies.mts",
    "preflight:staging": "node scripts/preflight-staging.mts",
    "register:client": "node scripts/register-client.mts",
    "deploy:staging": "npm run preflight:staging && wrangler deploy --config .dev.vars.staging.json",
    "types": "wrangler types --config wrangler.probe.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.3",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}
